    </resultMap>
	
	
	
	
    <!-- 게시글 조회 (검색/페이징/정렬 포함) -->
    <select id="findPostsForAdmin" resultMap="postDetailMap" parameterType="map">
        SELECT
            p.post_id, p.member_id, p.address_id, p.muni_code, p.disaster_type,
            p.title, p.body, p.lat, p.lon, p.status, p.view_count,
            p.created_at, p.updated_at, m.nickname
        FROM
            post p
        JOIN
            member m ON p.member_id = m.member_id
        WHERE
            p.status != 'DELETED'
        ORDER BY
            p.status DESC,
            p.created_at DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>
	
	
    <!-- 신고된 댓글만 조회 (페이징 적용) -->
    <select id="findReportedCommentsPaginated" resultType="com.disaster.domain.CommentDTO">
        SELECT
            DISTINCT c.comment_id, c.post_id, c.member_id, c.body, c.status,
            c.created_at, m.nickname, p.title
        FROM
            comment c
        JOIN
            comment_report cr ON c.comment_id = cr.comment_id
        JOIN
            member m ON c.member_id = m.member_id
        JOIN
            post p ON c.post_id = p.post_id
        ORDER BY
            c.created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>
    
    <!-- 신고된 댓글 전체 개수 조회 -->
    <select id="countReportedComments" resultType="int">
        SELECT COUNT(DISTINCT c.comment_id)
        FROM comment c
        JOIN comment_report cr ON c.comment_id = cr.comment_id
    </select>
    
    

    <!-- 게시글 소프트 삭제 -->
    <update id="softDeletePostById" parameterType="long">
        UPDATE post
        SET status = 'DELETED'
        WHERE post_id = #{postId}
    </update>

    <!-- 댓글 소프트 삭제 -->
    <update id="softDeleteCommentById" parameterType="long">
        UPDATE comment
        SET status = 'DELETED'
        WHERE comment_id = #{commentId}
    </update>
    
    
    <!-- 소프트 삭제된 게시물 조회 (페이징 적용) -->
